    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "@mlc-ai/web-llm": "0.2.85",
    "onnxruntime-web": "1.18.0",
